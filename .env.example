# Copy this file to `.env` and fill in your real values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Your Calendly scheduling page base URL (no trailing slash).
# Each service in src/siteConfig.js appends its own slug to this,
# e.g. https://calendly.com/your-handle/bridal-trial
# Create one Calendly "event type" per service and make sure the
# slugs match what's in src/siteConfig.js.
VITE_CALENDLY_URL=https://calendly.com/your-handle

# Your Formspree form ID (from https://formspree.io — create a free
# form, it gives you an ID like "abcdwxyz"). Powers the contact form
# on the Contact page.
VITE_FORMSPREE_ID=your-form-id
